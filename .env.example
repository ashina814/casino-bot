# ═══ 必須 ═══════════════════════════════════════════
# Discord Developer Portal → Bot → Token
DISCORD_TOKEN=your_bot_token_here

# Discord Developer Portal → General Information → Application ID
CLIENT_ID=your_application_id

# ═══ 任意 ═══════════════════════════════════════════

# 特定サーバーにのみコマンドをデプロイする場合（開発・テスト用）
# 未設定なら **global デプロイ**（全サーバーで使える、反映に最大1時間）
# 本番マルチサーバー運用なら未設定（空欄のまま）でOK
GUILD_ID=

# 定期競馬レース（土日21:00 JST）を実行するチャンネル
# 未設定なら定期レースは止まる（手動 /競馬 start は各サーバーで可能）
RACE_CHANNEL_ID=

# オーナーの Discord ユーザーID
# 設定すると /管理 監視 ダッシュボードで集計から除外される（自分の巨額残高で歪まないように）
OWNER_ID=

# ═══ 両替API（GilBeinBOT / LUXEL 連携） ═══════════════
# ルクス ⇄ エテル の両替。両方セットした時だけ /両替 が有効になる。
# 未設定なら /両替 は「準備中」応答（安全に無効化）。
#
# Gil-bot 側の公開URL（Cloudflare Tunnel / Render / 独自ドメイン等）
# 例: https://own-shadow-starts-masters.trycloudflare.com
EXCHANGE_API_BASE_URL=
# Gil-bot 側と一致させる API キー（X-API-Key ヘッダで送る）
EXCHANGE_API_KEY=

# ── 疎通テスト用（任意・本番動作には不要） ──
# Gil-bot 側に残高があるテスト用 guildId / userId
TEST_EXCHANGE_GUILD_ID=
TEST_EXCHANGE_USER_ID=
